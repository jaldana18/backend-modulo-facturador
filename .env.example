# Environment
NODE_ENV=development
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=YourStrongPassword123!
DB_NAME=inventory_db
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-characters-long-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Configuration (AES-256-GCM requires 32-byte key = 64 hex chars)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Logger Configuration
LOG_LEVEL=debug
LOG_FILE_MAX_SIZE=5242880
LOG_FILE_MAX_FILES=10

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# API Configuration
API_PREFIX=/api
API_VERSION=v1

# Schema Validation
VALIDATE_SCHEMA_ON_STARTUP=true
STRICT_SCHEMA_VALIDATION=false

# Migration Configuration
# AUTO_RUN_MIGRATIONS: Automatically run pending migrations on startup (true/false)
# - Development: Recommended 'true' for automatic schema sync
# - Production: Recommended 'false' for manual control
AUTO_RUN_MIGRATIONS=true

# FORCE_MIGRATIONS_IN_PRODUCTION: Allow automatic migrations in production (true/false)
# - WARNING: Only set to 'true' if you fully trust your migration scripts
# - Production deployments should typically run migrations manually
FORCE_MIGRATIONS_IN_PRODUCTION=false
